# Local Ollama endpoint. Keep this local unless you intentionally use a remote provider.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=600000

# Obsidian vault path.
LIBRARIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Optional cloud/provider API key. Do not set this unless you accept sending
# selected note content to that provider.
# ZAI_API_KEY=
