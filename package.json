{
  "name": "librarian",
  "version": "0.1.0",
  "description": "Experimental local-first agent for maintaining an Obsidian LLM Wiki.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agents4Life/librarian.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "librarian": "./dist/index.js"
  },
