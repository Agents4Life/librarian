    "test": "node --test --import tsx",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ink": "^7.0.2",
    "react": "^19.2.6"
  }
}
